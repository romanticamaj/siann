{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIANN_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SIANN_WERROR": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Debug, Ninja, with JUCE (AGPLv3)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "SIANN_WITH_JUCE": "ON"
      }
    },
    {
      "name": "rtsan",
      "displayName": "Debug, Ninja, Clang RealtimeSanitizer (Linux, Clang 20+; set CMAKE_CXX_COMPILER)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/rtsan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "SIANN_RTSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "rtsan",
      "configurePreset": "rtsan",
      "environment": {
        "RTSAN_OPTIONS": "halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
