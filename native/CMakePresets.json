{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIANN_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release, Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SIANN_WERROR": "ON"
      }
    },
    {
      "name": "desktop",
      "displayName": "Debug, Ninja, with JUCE (AGPLv3)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "SIANN_WITH_JUCE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
