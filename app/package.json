{
  "name": "siann-app",
  "version": "0.1.0",
  "private": true,
  "description": "SIANN desktop shell: Electron app that spawns and supervises siann-engine",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "main": "dist/src/main/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/bundle-renderer.js",
    "test:unit": "node --test dist/test/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.2"
  }
}
