{
  "schemaVersion": "siann.fidelity.v1",
  "about": "The mockup fidelity gate (docs/harness/agent-rules.md, \"UI fidelity\"). Every data-region / data-part id of the mockup is owned by exactly one rule (first match wins). feature: the feature that builds the part. gate: the feature whose acceptance ports these parts and attaches their side-by-side screenshot: for a part M5 built, the feature that ports it from the mockup's markup (m5-ui-alignment-chrome and the m5-ui-port-* features); otherwise the feature itself. Decided by the maintainer, 2026-11-17 (UI redesign 10.9): the gate is a visual aid and its run never blocks. gates: pending = skipped until that feature lands, and until then the part is absent and its space stays empty; report = measured and reported, never failing. There is no enforce mode any more: a feature that lands sets its gate from pending to report, and test/mockup-fidelity.test.js fails on a gate that is enforce. No part is unowned (decided by the maintainer, 2026-11-15): a rule with no feature fails test/mockup-fidelity.test.js.",
  "mockup": "docs/superpowers/specs/2026-11-13-siann-ui-redesign/mockup.html",
  "viewport": {
    "width": 1440,
    "height": 900,
    "deviceScaleFactor": 1
  },
  "locales": {
    "en": {
      "query": "",
      "languages": ["en-US"]
    },
    "zh-TW": {
      "query": "?lang=zh-TW",
      "languages": ["zh-TW"]
    }
  },
  "environment": {
    "about": "Decided by the maintainer, 2026-11-15 (UI redesign 10.2): device and build data are not part of the session, so the fidelity run alone answers engine.status's device and engine.about with the mockup's values. mockup-fidelity.spec.ts passes this object as SIANN_FIDELITY_ENVIRONMENT, which the shell reads only under SIANN_SHELL_TEST=1; outside that run the status bar is built from the engine's own answers. The status bar draws them as ASIO · Scarlett 4i4 · 48 kHz / 128 · 5.3 ms (one latency, the round trip: input plus output) and siann-engine 0.1.0 (308d846) · AGPL-3.0-or-later.",
    "device": {"id": "ASIO/Scarlett 4i4", "sampleRate": 48000, "bufferFrames": 128, "inputLatencyFrames": 128, "outputLatencyFrames": 128},
    "engineAbout": {"name": "siann-engine", "version": "0.1.0", "license": "AGPL-3.0-or-later", "source": {"commit": "308d846000000000000000000000000000000000", "dirty": false}}
  },
  "regions": ["top-bar", "left-zone", "project-zone", "lower-zone", "right-zone", "status-bar"],
  "geometry": {
    "tolerancePx": 1
  },
  "styles": ["color", "background-color", "font-family", "font-size", "font-weight", "line-height", "letter-spacing", "text-transform", "font-variant-numeric", "border-top-width", "border-right-width", "border-bottom-width", "border-left-width", "border-top-style", "border-right-style", "border-bottom-style", "border-left-style", "border-top-color", "border-right-color", "border-bottom-color", "border-left-color", "border-top-left-radius", "border-top-right-radius", "border-bottom-right-radius", "border-bottom-left-radius", "padding-top", "padding-right", "padding-bottom", "padding-left", "box-shadow", "opacity"],
  "pixels": {
    "channelTolerance": 16,
    "maxMismatch": 0.005,
    "note": "Chrome only: waveform interiors and dynamic content are masked entirely (maintainer, 2026-11-14), as are parts whose gate is pending. DSP load and the master's loudness value are meter levels and joined the list when they got an owner (2026-11-15). Decided by the maintainer, 2026-11-15 (UI redesign 10.5, second round): the three history rows (plan-history-1 to 3: their titles and the agent's name need E-7 and E-14) were masked until m5b-ui-plan-metadata, which shows both, removed them from this list (what still differs, the time, the revision, Roll back and the stale row's detail, is reported), and the titles of the steps that name a clip (plan-step-N-title: a clip has no name before the clip half of E-4) until m5b-ui-media narrows that mask: it unmasks plan-step-6-title (\"Move Riser on FX\": the media is named Riser) and leaves plan-step-2-title masked, whose mockup text names the clip \"Pad swell\" while its media is pad_swell.wav, until the clip half of E-4 has an owner (decided by Fable, delegated by the maintainer, 2026-11-18; UI redesign 10.11). The history head (plan-history-head) is not masked: M5 derives it.",
    "dynamic": ["display-*", "dsp-load", "strip-master-loudness", "status-device", "status-xruns", "status-saved", "status-about", "plan-meta", "*-meter", "*-readout", "info-start", "info-end", "info-length", "info-offset", "info-volume", "track-count", "cursor", "cursor-head", "plan-step-2-title"]
  },
  "gates": {
    "m5-ui-alignment-chrome": "report",
    "m5-ui-port-arrange-canvas": "report",
    "m5-ui-port-mixer-strip": "report",
    "m5-ui-port-plans": "report",
    "m5-ui-port-inspector": "report",
    "m5-ui-port-track-list": "report",
    "m5-ui-port-toolbar": "report",
    "m5b-ui-ghosts": "report",
    "m5b-ui-audition": "report",
    "m5b-ui-media": "report",
    "m5b-ui-edit-more": "report",
    "m5b-ui-fades": "report",
    "m5b-ui-inserts-master": "report",
    "m5b-ui-recording": "report",
    "m5b-ui-markers": "pending",
    "m5b-ui-sends-buses": "pending",
    "m5b-ui-signature": "report",
    "m5b-ui-meter": "report",
    "m5b-ui-plan-metadata": "report",
    "m5b-ui-composer": "report",
    "m5b-ui-notepad": "report",
    "m5b-ui-editor-channel": "pending",
    "m6a-ui-automation": "pending",
    "m6a-ui-tools": "pending",
    "m6c-ui-master-channel": "pending"
  },
  "rules": [
    {"match":["*ghost*","proposal-pill","inspector-agent-changes"],"feature":"m5b-ui-ghosts","gate":"m5b-ui-ghosts"},
    {"match":["*-record","inspector-monitor"],"feature":"m5b-ui-recording","gate":"m5b-ui-recording"},
    {"match":["*-read","*-write","strip-*-automation","inspector-automation"],"feature":"m6a-ui-automation","gate":"m6a-ui-automation"},
    {"match":["dsp-load","strip-master-loudness","tab-meter"],"feature":"m5b-ui-meter","gate":"m5b-ui-meter"},
    {"match":["display-signature"],"feature":"m5b-ui-signature","gate":"m5b-ui-signature"},
    {"match":["agent-row","plan-title","plan-intent"],"feature":"m5b-ui-plan-metadata","gate":"m5b-ui-plan-metadata"},
    {"match":["composer"],"feature":"m5b-ui-composer","gate":"m5b-ui-composer"},
    {"match":["inspector-notepad"],"feature":"m5b-ui-notepad","gate":"m5b-ui-notepad"},
    {"match":["strip-master-inserts","strip-master-edit","strip-master-buttons","strip-master-mute"],"feature":"m6c-ui-master-channel","gate":"m6c-ui-master-channel"},
    {"match":["tab-editor","zone-button-channel","strip-*-edit","inspector-edit"],"feature":"m5b-ui-editor-channel","gate":"m5b-ui-editor-channel"},
    {"match":["strip-*-inserts","strip-master-fader","strip-master-cap","inspector-inserts","mixer-racks"],"feature":"m5b-ui-inserts-master","gate":"m5b-ui-inserts-master"},
    {"match":["inspector-routing","inspector-sends"],"feature":"m5b-ui-sends-buses","gate":"m5b-ui-sends-buses"},
    {"match":["marker-head","marker-track"],"feature":"m5b-ui-markers","gate":"m5b-ui-markers"},
    {"match":["info-fade-in","info-fade-out"],"feature":"m5b-ui-fades","gate":"m5b-ui-fades"},
    {"match":["tab-media","plan-step-*-title"],"feature":"m5b-ui-media","gate":"m5b-ui-media"},
    {"match":["tool-4","tool-5"],"feature":"m5b-ui-edit-more","gate":"m5b-ui-edit-more"},
    {"match":["tool-8"],"feature":"m6a-ui-automation","gate":"m6a-ui-automation"},
    {"match":["tool-2","tool-6","tool-7","tool-9"],"feature":"m6a-ui-tools","gate":"m6a-ui-tools"},
    {"match":["branch-chip"],"feature":"m5b-ui-audition","gate":"m5b-ui-audition"},
    {"match":["transport-cycle","transport-click","transport-metronome","display-locators"],"feature":"m5-ui-loop-click","gate":"m5-ui-alignment-chrome"},
    {"match":["locator-band"],"feature":"m5-ui-loop-click","gate":"m5-ui-port-arrange-canvas"},
    {"match":["auto-scroll"],"feature":"m5-ui-transport","gate":"m5-ui-port-toolbar"},
    {"match":["cursor","cursor-head"],"feature":"m5-ui-transport","gate":"m5-ui-port-arrange-canvas"},
    {"match":["transport","transport-*","display","display-*","undo","redo"],"feature":"m5-ui-transport","gate":"m5-ui-alignment-chrome"},
    {"match":["tools","tool-1","tool-3"],"feature":"m5-ui-edit-basics","gate":"m5-ui-port-toolbar"},
    {"match":["top-bar","brand","session-name","zone-buttons","zone-button-*","plans-button","plans-count","status-bar","status-*"],"feature":"m5-ui-shell","gate":"m5-ui-alignment-chrome"},
    {"match":["left-zone","inspector-*"],"feature":"m5-ui-mixer","gate":"m5-ui-port-inspector"},
    {"match":["lower-zone","lower-tabs","tab-mixconsole","mixer","strip-*"],"feature":"m5-ui-mixer","gate":"m5-ui-port-mixer-strip"},
    {"match":["right-zone","right-tabs","tab-plans","hearing-switch","plan-*"],"feature":"m5-ui-plan-panel","gate":"m5-ui-port-plans"},
    {"match":["toolbar","snap","grid-type","info-line","info-*"],"feature":"m5-ui-arrange","gate":"m5-ui-port-toolbar"},
    {"match":["track-list","track-list-head","track-add","track-count","track-*"],"feature":"m5-ui-arrange","gate":"m5-ui-port-track-list"},
    {"match":["project-zone","arrange","event-display","scroll-zoom","ruler-upper","ruler-lower","lane-*","clip-*"],"feature":"m5-ui-arrange","gate":"m5-ui-port-arrange-canvas"}
  ]
}
